<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and older (BRD BAK-F4, D74): the diary, the settings kept in shared preferences, and the automatic
    backups taken before an import. The cache, where PDF reports go, is never backed up.
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <include domain="file" path="backups/" />
</full-backup-content>
