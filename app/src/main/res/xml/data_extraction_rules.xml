<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 and later (BRD BAK-F4, D74): the same as backup_rules.xml, for the cloud backup and for moving to a new
    phone. The cache, where PDF reports go, is never backed up.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
