<!--
  The launcher reads the shortcut's labels with the phone's own language list, not Migrely's language rule (BRD D195).
  values/ is not tagged English, so for ru-RU, en-US, de-DE Android would pick values-de while the app is English.
  These copies make English match first. They equal values/; LocalizationCompletenessTest checks it.
-->
<resources>
    <string name="shortcut_start_attack">Migraine started</string>
    <string name="shortcut_start_attack_long">Log that a migraine started</string>
</resources>
