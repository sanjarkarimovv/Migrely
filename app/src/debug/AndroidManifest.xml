<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!--
            Debug builds only: QA sets the simulated store from adb (BRD D113). DUMP, which adb's
            shell holds, keeps other apps out (review M14).
        -->
        <receiver
            android:name=".datasource.billing.datasource.SimulatedBillingReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.migrely.app.debug.SIMULATED_STORE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
